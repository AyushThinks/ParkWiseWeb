# SQLite is used by default. No environment variable is required.
# DATABASE_URL=sqlite:///./parkwise.db

# To use PostgreSQL, create a database named parkwise and uncomment:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/parkwise

# JWT secret key for authentication tokens
# JWT_SECRET=your-secret-key-here-change-in-production
